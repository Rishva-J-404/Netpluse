# NETPULSE Backend Environment Configuration
# Course: Probability and Statistics for Computer Science (25CS203)

# FastAPI Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Project Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY secret on backend only; NEVER expose to frontend!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth Mode: Set to 1 for offline testing with mock tokens; 0 for live GoTrue verification
NETPULSE_TEST_AUTH=0
